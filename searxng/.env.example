# SIFT / SearXNG Environment Configuration
# Pinned version tag for reproducible local deployments
SEARXNG_VERSION=2026.8.29-d226b78bc

# Public port where SIFT Web is accessible (default: 3000)
SIFT_PORT=3000

# SearXNG internal aggregation port (default: 8080)
SEARXNG_PORT=8080

# Secret key used for cryptographic session encryption
# In production, replace with a random 32-byte hex string (e.g. `openssl rand -hex 32`)
SEARXNG_SECRET=change_this_to_a_secure_random_key_in_production

# SIFT Local AI Overview Configuration (llama.cpp)
# SIFT_LLM_ENABLED controls the server-side LLM capability (true/false)
SIFT_LLM_ENABLED=true
# Internal or local URL for llama.cpp HTTP server
SIFT_LLM_URL=http://llama-server:8080
# Path to GGUF model mounted inside the container
SIFT_LLM_MODEL=/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# CPU Inference tuning (conservative settings for 4C/8T, 8GB RAM)
SIFT_LLM_THREADS=4
SIFT_LLM_CTX_SIZE=2048
SIFT_LLM_N_PREDICT=512
